{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/blocks/**",
              "components/cards/**",
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/layout/**",
              "components/tiles/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Sora|Alexandria))/i]",
        "message": "Font not provided by the design system. Available: Sora, Alexandria."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:brand|basePath|src|icon|alt|label|tone|size|style|key|ref|className|style|children)$/]",
        "message": "<BrandTile> doesn't accept that prop. Declared props: brand, basePath, src, icon, alt, label, tone, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrandTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:auto|dark|light)$/]",
        "message": "<BrandTile> tone must be one of 'auto' | 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconStart|href|disabled|fullWidth|type|onClick|style|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconStart, href, disabled, fullWidth, type, onClick, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|dark|outline)$/]",
        "message": "<Button> variant must be one of 'primary' | 'dark' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:on|variant|padding|interactive|href|style|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: on, variant, padding, interactive, href, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='on'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Card> on must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|highlight|highlight-orange|exceptional)$/]",
        "message": "<Card> variant must be one of 'default' | 'highlight' | 'highlight-orange' | 'exceptional'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTABlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|title|text|actionLabel|actionHref|onAction|icon|children|style|key|ref|className|style|children)$/]",
        "message": "<CTABlock> doesn't accept that prop. Declared props: variant, title, text, actionLabel, actionHref, onAction, icon, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTABlock'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:gradient|orange|dark|cream)$/]",
        "message": "<CTABlock> variant must be one of 'gradient' | 'orange' | 'dark' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FAQ'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|on|title|subtitle|eyebrow|action|defaultOpen|style|key|ref|className|style|children)$/]",
        "message": "<FAQ> doesn't accept that prop. Declared props: items, on, title, subtitle, eyebrow, action, defaultOpen, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FAQ'] > JSXAttribute[name.name='on'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<FAQ> on must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterE'] > JSXAttribute > JSXIdentifier[name!=/^(?:logoSrc|logoAlt|sunsetSrc|description|socials|columns|contact|cta|copyright|style|key|ref|className|style|children)$/]",
        "message": "<FooterE> doesn't accept that prop. Declared props: logoSrc, logoAlt, sunsetSrc, description, socials, columns, contact, cta, copyright, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Glass'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|strong|padding|style|children|key|ref|className|style|children)$/]",
        "message": "<Glass> doesn't accept that prop. Declared props: tone, strong, padding, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Glass'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<Glass> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|active|items|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: label, href, active, items."
      },
      {
        "selector": "JSXOpeningElement[name.name='Highlight'] > JSXAttribute > JSXIdentifier[name!=/^(?:style|children|key|ref|className|style|children)$/]",
        "message": "<Highlight> doesn't accept that prop. Declared props: style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|mirror|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, mirror, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|logo|logoAlt|logoMono|glowOpacity|tone|size|glow|iconColor|iconSize|style|children|key|ref|className|style|children)$/]",
        "message": "<IconTile> doesn't accept that prop. Declared props: icon, logo, logoAlt, logoMono, glowOpacity, tone, size, glow, iconColor, iconSize, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:auto|dark|light)$/]",
        "message": "<IconTile> tone must be one of 'auto' | 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|label|type|placeholder|options|rows|id|hint|error|value|defaultValue|onChange|style|inputStyle|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: as, label, type, placeholder, options, rows, id, hint, error, value, defaultValue, onChange, style, inputStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:input|select|textarea)$/]",
        "message": "<Input> as must be one of 'input' | 'select' | 'textarea'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoMarquee'] > JSXAttribute > JSXIdentifier[name!=/^(?:logos|tone|height|gap|duration|style|key|ref|className|style|children)$/]",
        "message": "<LogoMarquee> doesn't accept that prop. Declared props: logos, tone, height, gap, duration, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoMarquee'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<LogoMarquee> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NewLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:badge|href|style|children|key|ref|className|style|children)$/]",
        "message": "<NewLabel> doesn't accept that prop. Declared props: badge, href, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='NumberBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|style|children|key|ref|className|style|children)$/]",
        "message": "<NumberBadge> doesn't accept that prop. Declared props: variant, size, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='NumberBadge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:gradient|dark)$/]",
        "message": "<NumberBadge> variant must be one of 'gradient' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute > JSXIdentifier[name!=/^(?:bg|size|beforeSunset|contained|maxWidth|id|padTop|padBottom|style|innerStyle|children|key|ref|className|style|children)$/]",
        "message": "<Section> doesn't accept that prop. Declared props: bg, size, beforeSunset, contained, maxWidth, id, padTop, padBottom, style, innerStyle, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute[name.name='bg'] > Literal[value!=/^(?:white|cream|cream-warm|dark)$/]",
        "message": "<Section> bg must be one of 'white' | 'cream' | 'cream-warm' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:default|sm|none)$/]",
        "message": "<Section> size must be one of 'default' | 'sm' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|subtitle|align|level|display|maxWidth|actions|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, title, subtitle, align, level, display, maxWidth, actions, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|start)$/]",
        "message": "<SectionHeading> align must be one of 'center' | 'start'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|size|gradient|align|style|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: value, label, size, gradient, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Stat> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:start|center)$/]",
        "message": "<Stat> align must be one of 'start' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sunset'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|src|alt|style|key|ref|className|style|children)$/]",
        "message": "<Sunset> doesn't accept that prop. Declared props: variant, src, alt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sunset'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:cream-to-dark|dark-to-cream)$/]",
        "message": "<Sunset> variant must be one of 'cream-to-dark' | 'dark-to-cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|icon|style|children|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: variant, icon, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:neutral|accent)$/]",
        "message": "<Tag> variant must be one of 'neutral' | 'accent'."
      }
    ]
  },
